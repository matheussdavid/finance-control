# PostgreSQL
POSTGRES_DB=finance_control
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance_pass
POSTGRES_PORT=5432

# Backend
DB_URL=jdbc:postgresql://postgres:5432/finance_control
DB_USERNAME=finance
DB_PASSWORD=finance_pass
JWT_SECRET=<gerar-secret-aleatorio-de-pelo-menos-32-caracteres>
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend (build time). Use "/api" to route through the nginx proxy in Docker,
# or "http://localhost:8080" when running the app locally without Docker.
VITE_API_BASE_URL=/api

# Portas expostas
BACKEND_PORT=8080
FRONTEND_PORT=5173
